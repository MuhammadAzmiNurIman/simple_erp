# ==============================================================================
# DistribuFlow ERP - Production Environment Configuration Template
# Copy this file to .env and fill in the values before deploying to production.
# ==============================================================================

# Application Environment (production, staging, development)
FLASK_APP=run.py
FLASK_ENV=production
PORT=5000

# Security Secrets (MUST be random, cryptographically secure 64-char hex strings in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_key_64_characters_min
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_64_characters_min

# Database Connection URL
# For Production MySQL 8.x (InnoDB with utf8mb4):
DATABASE_URL=mysql+pymysql://erp_user:secure_password@127.0.0.1:3306/distribuflow_prod?charset=utf8mb4

# Rate Limiter Storage URI
# In multi-worker production, a shared Redis backend is required:
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# Default rate limits (semicolon-separated)
RATELIMIT_DEFAULT_LIMITS=20000 per day;2000 per hour

# CORS allowlist (comma-separated). Production requires explicit origins;
# wildcards are rejected and the application will refuse to start.
CORS_ORIGINS=https://erp.example.com

# File Upload Settings
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216

# Smorest / OpenAPI Configuration
API_TITLE=DistribuFlow ERP API v1.1
API_VERSION=1.1
OPENAPI_VERSION=3.0.2
